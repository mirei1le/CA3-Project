<%- include('../partials/header') %>
<%
  const action = user ? '/admin/users/' + user._id : '/admin/users';
  const role = user ? user.role : 'student';
%>

<h1><%= title %></h1>

<div class="card">
  <form method="post" action="<%= action %>">
    <label for="name">Full name</label>
    <input type="text" id="name" name="name" value="<%= user ? user.name : '' %>" required>

    <label for="email">Email</label>
    <input type="email" id="email" name="email" value="<%= user ? user.email : '' %>" required>

    <label for="password">Password <%= user ? '(leave blank to keep the current one)' : '' %></label>
    <input type="password" id="password" name="password" <%= user ? '' : 'required' %>>

    <label for="role">Role</label>
    <select id="role" name="role">
      <option value="student" <%= role === 'student' ? 'selected' : '' %>>Student</option>
      <option value="lecturer" <%= role === 'lecturer' ? 'selected' : '' %>>Lecturer</option>
      <option value="admin" <%= role === 'admin' ? 'selected' : '' %>>Admin</option>
    </select>

    <label for="studentNumber">Student number (students only)</label>
    <input type="text" id="studentNumber" name="studentNumber" value="<%= user ? user.studentNumber : '' %>">

    <label for="phone">Phone</label>
    <input type="text" id="phone" name="phone" value="<%= user ? user.phone : '' %>">

    <label for="address">Address</label>
    <input type="text" id="address" name="address" value="<%= user ? user.address : '' %>">

    <label for="dateOfBirth">Date of birth</label>
    <input type="date" id="dateOfBirth" name="dateOfBirth" value="<%= user ? user.dateOfBirth : '' %>">

    <button type="submit">Save user</button>
    <a href="/admin/users">Cancel</a>
  </form>
</div>

<%- include('../partials/footer') %>
